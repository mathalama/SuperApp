# =========================================================================
# Root .gitignore for SuperApp Monorepo
# =========================================================================

# --- Environment & Sensitive Files ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*

# --- IDEs and Editors ---
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/
**/out/

# Visual Studio Code
.vscode/
*.code-workspace

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# Eclipse
.classpath
.project
.settings/
.factorypath
.springBeans

# --- Build and Dependency Tools ---
# Gradle
.gradle/
build/
**/build/
**/.gradle/

# Gradle Wrapper (ensure it is NOT ignored if wrappers are kept in subfolders)
!**/gradle/wrapper/gradle-wrapper.jar

# Gradle/Java binaries and outputs
bin/
**/bin/

# --- Compiled/Executable Java files ---
*.class
*.jar
*.war
*.ear
!**/gradle/wrapper/gradle-wrapper.jar

# --- Operating System Files ---
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# --- Node.js & Frontend ---
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
**/dist-ssr/
*.local
.npm/
.vite/
**/.vite/

# --- Python ---
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
*.egg-info/
.pytest_cache/
.coverage

# --- Logs & Temp ---
*.log
**/*.log
.aider*

# --- Kubernetes & Infrastructure Secrets ---
# Raw Kubernetes secrets manifests (allow example/template files)
k8s/*secret*.yaml
k8s/*secrets*.yaml
k8s/*secret*.yml
k8s/*secrets*.yml
!k8s/*secret*.example.yaml
!k8s/*secrets*.example.yaml
!k8s/*secret*.template.yaml
!k8s/*secrets*.template.yaml
!k8s/*secret*.example.yml
!k8s/*secrets*.example.yml

# Cluster credentials, contexts and kubeconfigs
kubeconfig
*.kubeconfig
k8s/kubeconfig*
.kube/

# TLS / SSL Certificates and private keys
*.pem
*.key
*.crt
*.csr
*.pfx
*.p12

# Helm & Kustomize local builds/artifacts
*.tgz
.helm/
charts/*/charts/
k8s/local/
k8s/overlays/local/

# Decrypted SOPS / SealedSecrets files
*.dec.yaml
*.dec.yml
*.decrypted.yaml
*.decrypted.yml
