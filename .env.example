# ==============================================================================
# SuperApp Environment Variables Template
# Copy this file to .env and adjust variables as needed
# ==============================================================================

# APPLICATION PORTS
GATEWAY_PORT=8700
FRONTEND_URL=http://localhost:3000
BASE_URL=http://localhost:8700

# DATABASE (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
IDENTITY_DB=identity_db
USER_DB=user_db
KYC_DB=kyc_db
POSTGRES_PORT=8500

# REDIS
REDIS_HOST=redis
REDIS_PORT=8501
REDIS_PASSWORD=redis

# KAFKA
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2QkQ2Qk
KAFKA_PORT=8502

# ZIPKIN (Distributed Tracing)
ZIPKIN_PORT=8503

# SECURITY & JWT
SECURITY_USER=admin
SECURITY_PASSWORD=admin
JWT_SECRET=replace_with_a_secure_random_base64_secret_at_least_256_bits_long
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# OAUTH (Google)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# VERIFICATION & SECURITY TIMEOUTS
VERIFICATION_TOKEN_EXPIRY_MINUTES=30
VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# MAIL CONFIGURATION (SMTP)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=your_smtp_password

# MINIO / S3 OBJECT STORAGE
S3_USER=minioadmin
S3_PASSWORD=minioadmin
S3_PORT=8504
S3_CONSOLE_PORT=8505
S3_BUCKET_AVATARS=avatars
S3_BUCKET_KYC=kyc-documents
S3_PUBLIC_URL=http://localhost:8504

# KYC ML SERVICE
KYC_ML_SERVICE_URL=http://kyc-ml-service:8000
